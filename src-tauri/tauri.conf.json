{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albedo",
  "version": "0.1.0",
  "identifier": "de.codana.albedo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Albedo",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#0F1214",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        },
        "label": "main",
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 640,
        "height": 400,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "title": "Albedo",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "CAD für den 3D-Druck",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "albedo"
}